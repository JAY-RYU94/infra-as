#!/usr/bin/env bash
# Copy this file to hyperv.env, fill in the values, then run:
#   source ./hyperv.env
# hyperv.env is ignored by Git.

export HYPERV_BACKEND="winrm"
export HYPERV_HOST="hyperv01.infra.example.com"
export HYPERV_PORT="5986"
export HYPERV_USERNAME="DOMAIN\\hyperv-terraform"
export HYPERV_WINRM_USE_HTTPS="true"
export HYPERV_WINRM_AUTH="ntlm"
export HYPERV_TIMEOUT="30m"

# For an internal CA, point this at a PEM CA certificate visible inside WSL.
export HYPERV_WINRM_CACERT="/mnt/c/secure/asol-winrm-ca.pem"
export HYPERV_WINRM_INSECURE="false"

if [[ -z "${HYPERV_PASSWORD:-}" ]]; then
  read -rsp 'Hyper-V WinRM password: ' HYPERV_PASSWORD
  printf '\n'
  export HYPERV_PASSWORD
fi

# ISO builder inputs. These files stay outside Git and must be mode 0600.
export ASOLADMIN_PASSWORD_FILE="${HOME}/.config/asol-infra/secrets/asoladmin-initial-password"
export ASOLADMIN_SSH_PUBLIC_KEY_FILE="${HOME}/.ssh/id_ed25519.pub"
export K3S_TOKEN_FILE="${HOME}/.config/asol-infra/secrets/k3s-cluster-token"

# Keep sensitive generated media on the WSL Linux filesystem, never /mnt/c.
export ASOL_ARTIFACT_DIR="${HOME}/.local/share/asol-infra/artifacts"
export OUTPUT_ISO="${ASOL_ARTIFACT_DIR}/asol-k3s-ubuntu-24.04.4-autoinstall.iso"

# Static Ubuntu network settings written into the unattended installer.
export VM_HOSTNAME="asol-k3s-01"
export VM_MAC_ADDRESS="00:15:5D:01:02:03"
export VM_ADDRESS_CIDR="192.0.2.31/24"
export VM_GATEWAY="192.0.2.1"
export VM_DNS_SERVERS="192.0.2.53,192.0.2.54"
export VM_DNS_SEARCH="infra.example.com"
export K3S_TLS_SAN="k3s.infra.example.com"

# Feed the same identity values to Terraform/OpenTofu.
export TF_VAR_vm_name="${VM_HOSTNAME}"
export TF_VAR_vm_mac_address="${VM_MAC_ADDRESS}"
export TF_VAR_vm_address_cidr="${VM_ADDRESS_CIDR}"
export TF_VAR_virtual_switch_name="External"
export TF_VAR_install_iso_local_path="${OUTPUT_ISO}"
